---
// 首頁「今天」資訊列(2026-10-01):日期星期、農曆、下一個連假。沿用清運點頁今天卡片的
// 共用函式(today-card-client / datetime),不碰垃圾車資料。「今天」一律前端以 Asia/Taipei 現算;
// 任一段算不出就省略該段,全部算不出整條維持 hidden。
import { allLongWeekendEntries, nationalHolidayDates } from '../lib/calendar';
import SearchBox from './SearchBox.astro';
import Card from './ui/Card.astro';
---

<Card id="today-strip" hidden data-entries={JSON.stringify(allLongWeekendEntries())} data-holidays={JSON.stringify(nationalHolidayDates())}>
  <p class="strip-row" data-row="date" hidden></p>
  <p class="strip-row" data-row="lunar" hidden><a href="/lunar/"></a></p>
  <p class="strip-row" data-row="holiday" hidden><a href="/calendar/"></a></p>
  <!-- 我的清運點(2026-10-01):localStorage 的 point_id 清單,在瀏覽器端逐一查 /trash/home-point.json,
       依「下一班」排序。載入失敗只隱藏這一行,其餘照常。狀態:已設定 / 未設定(接 SearchBox)/ 全部失效。 -->
  <div class="strip-home" data-row="home" hidden>
    <div data-state="set" hidden>
      <ul class="my-points"></ul>
      <p class="home-note" hidden></p>
      <p class="home-link"><a href="/trash/">搜尋並新增更多附近的清運點</a></p>
    </div>
    <div data-state="unset" hidden>
      <p class="home-line">搜尋你家附近任一個清運點,點進去後,可從「鄰近清運點」把附近的點一起加入</p>
      <SearchBox indexUrl="/trash/search-index.json" placeholder="輸入縣市、行政區、路名…" />
    </div>
    <div data-state="stale" hidden>
      <p class="home-line">之前設定的清運點已不存在,請重新設定</p>
      <SearchBox indexUrl="/trash/search-index.json" placeholder="輸入縣市、行政區、路名…" />
    </div>
  </div>
</Card>

<script>
  import { taipeiNowHHMM, taipeiToday, taipeiWeekday } from '../lib/datetime';
  import { dateLine, lunarLine, nextHolidayLine, nextRun, pickTodayLines } from '../lib/today-card-client';
  import { getMyPointIds, removeMyPoint } from '../lib/home-point';
  import type { HomePointToday } from '../lib/today-card';

  const strip = document.getElementById('today-strip');
  if (strip) {
    const today = taipeiToday();
    let shown = 0;
    const show = (name: string, text: string | null) => {
      try {
        const el = strip.querySelector<HTMLElement>(`[data-row="${name}"]`);
        if (!el || !text) return;
        const target = el.querySelector('a') ?? el;
        target.textContent = text;
        el.hidden = false;
        shown++;
      } catch {}
    };
    try {
      show('date', dateLine(today, taipeiWeekday(today)));
    } catch {}
    try {
      show('lunar', lunarLine(today));
    } catch {}
    try {
      const raw = strip.dataset.entries;
      show('holiday', nextHolidayLine(raw ? JSON.parse(raw) : null, today));
    } catch {}
    if (shown > 0) strip.hidden = false;

    // 我家清運點:獨立非同步區塊,任何錯誤只隱藏這一行,不影響上面的日期/農曆/連假。
    const home = strip.querySelector<HTMLElement>('[data-row="home"]');
    const state = (name: 'set' | 'unset' | 'stale') => {
      home!.querySelectorAll<HTMLElement>('[data-state]').forEach((e) => (e.hidden = e.dataset.state !== name));
      home!.hidden = false;
      strip.hidden = false;
    };
    type Row = { id: string; data: HomePointToday; key: number; run: string | null; line: string };
    const loadHome = async () => {
      if (!home) return;
      try {
        const ids = getMyPointIds();
        if (!ids.length) return state('unset');
        const weekday = taipeiWeekday(today);
        const nowHHMM = taipeiNowHHMM();
        const rawHolidays = strip.dataset.holidays;
        const holidays = rawHolidays ? JSON.parse(rawHolidays) : null;
        const isHoliday = Array.isArray(holidays) && holidays.includes(today);
        let stale = 0;
        const rows: Row[] = [];
        await Promise.all(
          ids.map(async (id) => {
            try {
              const res = await fetch(`/trash/home-point.json?id=${encodeURIComponent(id)}`);
              if (res.status === 404) {
                removeMyPoint(id); // 只移除失效的這一個
                stale++;
                return;
              }
              if (!res.ok) return; // 暫時性失敗:略過這一點、不動設定
              const data = (await res.json()) as HomePointToday;
              const lines = pickTodayLines(
                data.days as unknown as Record<string, unknown>,
                data.holidayFirst as unknown as Record<string, unknown>,
                holidays,
                today,
                weekday
              );
              if (!lines || !data.url || !data.name) return;
              const run = nextRun(data.times, weekday, nowHHMM);
              // 國定假日當天、下一班就是今天時,不能只丟一個時間,附註以公告為準
              const runText = run ? `${run.label}${isHoliday && run.offset === 0 ? '(國定假日,以公告為準)' : ''}` : null;
              rows.push({ id, data, key: run ? run.key : Number.MAX_SAFE_INTEGER, run: runText, line: lines[0] });
            } catch {}
          })
        );
        if (!rows.length) {
          if (stale > 0 && stale === ids.length) return state('stale');
          return; // 全部暫時性失敗:該行維持 hidden
        }
        rows.sort((a, b) => a.key - b.key || a.data.name.localeCompare(b.data.name));
        const list = home.querySelector<HTMLElement>('.my-points')!;
        list.replaceChildren(
          ...rows.map((r) => {
            const li = document.createElement('li');
            const head = document.createElement('p');
            head.className = 'my-point-head';
            const a = document.createElement('a');
            a.href = r.data.url;
            a.textContent = r.data.name;
            head.append(a);
            if (r.run) {
              const next = document.createElement('span');
              next.className = 'my-point-next';
              next.textContent = `下一班 ${r.run}`;
              head.append(' ', next);
            }
            const rm = document.createElement('button');
            rm.type = 'button';
            rm.className = 'my-point-remove';
            rm.textContent = '移除';
            rm.addEventListener('click', () => {
              removeMyPoint(r.id);
              loadHome();
            });
            head.append(rm);
            const line = document.createElement('p');
            line.className = 'my-point-line';
            line.textContent = r.line;
            if (r.data.queryUrl) {
              const q = document.createElement('a');
              q.href = r.data.queryUrl;
              q.rel = 'noopener';
              q.target = '_blank';
              q.textContent = '前往查詢';
              line.append(' ', q);
            }
            li.append(head, line);
            return li;
          })
        );
        const note = home.querySelector<HTMLElement>('.home-note')!;
        note.hidden = stale === 0;
        note.textContent = stale ? `有 ${stale} 個之前設定的清運點已不存在,已自動移除` : '';
        state('set');
      } catch {
        // 載入失敗:該行維持 hidden
      }
    };
    loadHome();
  }
</script>

<style>
  :global(#today-strip) {
    margin: 0 0 var(--spacing-lg);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--spacing-lg);
  }
  :global(#today-strip[hidden]) {
    display: none;
  }
  .strip-home {
    flex-basis: 100%;
  }
  .strip-home[hidden],
  .strip-home [hidden] {
    display: none;
  }
  .home-line,
  .home-link {
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }
  .home-line {
    font-weight: 600;
  }
  .home-link a,
  .home-line :global(a),
  .my-point-line :global(a),
  .my-point-head a {
    color: var(--color-brand-text);
    font-weight: 600;
  }
  .my-points {
    list-style: none;
    margin: 0 0 var(--spacing-sm);
    padding: 0;
  }
  .my-points > :global(li) {
    padding: 0.4rem 0;
    border-top: 1px solid var(--color-border);
  }
  .my-points > :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .my-point-head,
  .my-point-line {
    margin: 0;
    color: var(--color-ink);
  }
  .my-point-line {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .my-points :global(.my-point-next) {
    font-weight: 700;
    color: var(--color-ink);
    margin-left: 0.25rem;
  }
  .my-points :global(.my-point-remove) {
    margin-left: 0.75rem;
    background: none;
    border: 0;
    padding: 0.25rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: underline;
    cursor: pointer;
  }
  .home-note {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .strip-row {
    margin: 0;
    color: var(--color-ink);
  }
  .strip-row:first-child {
    font-weight: 600;
  }
  .strip-row :global(a) {
    color: var(--color-brand-text);
    font-weight: 600;
  }
</style>
