---
// MENGWABA Design System — FrogMark(規格 §6/§7:抽象青蛙識別)。
// Phase 3 元件庫,尚未套用到任何現有頁面。
//
// 2026-09-22 定案版:依 Jun 提供的 docs/brands/brand-board.png 重新描繪成向量——不是
// 逐點描圖(那樣路徑會很髒),是用參數化的等角螺線(Archimedean spiral)手繪出兩個
// 相同結構、左右鏡射的「捲捲眼」+ 一條微笑弧線,重現原圖識別特徵(捲眼+笑臉),但本身
// 是乾淨、可縮放的向量路徑。定稿前用 sharp 實際渲染大尺寸(400px)與 favicon 尺寸(32px/
// 48px)都檢查過清晰可辨識,渲染稿見 docs/brands/output/。
//
// 只有這個線稿本身(monochrome),用 currentColor 繼承外層顏色——呼叫端決定顏色時仍要
// 遵守 tokens.css 的對比度規則(不可用 --color-brand-face 當小尺寸圖示的唯一顏色,見
// tokens.css 開頭說明)。方形色底版(app icon/favicon 用,白色線稿疊在 --color-brand-face
// 底色上)是另一份靜態 SVG(docs/brands/output/symbol.svg),不是這個元件的職責。
interface Props {
  size?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { size = 32, ...rest } = Astro.props;
const height = Math.round(size * 0.8);
---

<svg
  width={size}
  height={height}
  viewBox="0 0 100 80"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
