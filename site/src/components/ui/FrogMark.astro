---
// MENGWABA Design System — FrogMark(規格 §6/§7:抽象青蛙識別)。
// Phase 3 元件庫,尚未套用到任何現有頁面(僅 LoadingState/EmptyState 內部使用)。
//
// 2026-09-23 定案版:改用 Jun 提供的最終向量(docs/brands/output/icon.svg)——實心填色 +
// evenodd 鏤空螺旋眼與微笑,取代 2026-09-22 那版用等角螺線手繪的 stroke 線稿。路徑本身
// 完全未修改,只調整了 viewBox(裁掉原始檔案裡的多餘留白,對應內容實際邊界,見下方
// VIEWBOX 常數),小尺寸(16/32/48px)與深色背景皆已用 sharp 實際渲染確認清晰可辨。
//
// 用 fill="currentColor" 繼承外層顏色,呼叫端決定顏色時仍要遵守 tokens.css 的對比度
// 規則(不可用 --color-brand-face 當小尺寸圖示的唯一顏色,見 tokens.css 開頭說明)。
// 方形版(favicon/app icon,2026-09-23 Jun 拍板:透明底 + 純品牌綠圖形,不加色底方塊)
// 是另一份靜態 SVG(docs/brands/output/favicon.svg 等),不是這個元件的職責。
interface Props {
  size?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { size = 32, ...rest } = Astro.props;
const VIEWBOX = { x: 18, y: 24, w: 215, h: 130 };
const height = Math.round((size * VIEWBOX.h) / VIEWBOX.w);
---

<svg
  width={size}
  height={height}
  viewBox={`${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.w} ${VIEWBOX.h}`}
  fill="currentColor"
  aria-hidden="true"
  {...rest}
>
