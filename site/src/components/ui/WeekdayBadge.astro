---
import '../../styles/tokens.css';

// MENGWABA Design System — WeekdayBadge(規格 §19「本週清運時間」的星期指示器)。
// Phase 3 元件庫,尚未套用到任何現有頁面——這是既有 components/WeekdayBadge.astro
// (目前仍在垃圾車正式頁面使用,本次不動它)的重新設計版本,Phase 6 垃圾車頁改版時才會
// 換成這一版,現在先在元件庫裡把問題修好放著。
//
// **發現的既有對比度問題(2026-09-22 Phase 3 盤點時抓到)**:現行版本「未收運」的字用
// `color: var(--border)`(#e2e2e2),對白底僅約 1.3:1,遠低於 WCAG AA 對文字的 4.5:1
// 門檻——即使是「刻意淡化的次要狀態」,使用者仍必須看得出那個字是「一」「二」...而不是
// 一片空白,不能低到幾乎看不見。這一版改用 --color-muted(#5b5b5b,對白底 6.79:1),
// 兩種狀態都通過 AA:
//   啟用(on)  --color-brand-text / 白 = 5.37:1
//   未啟用(off) --color-muted / 白    = 6.79:1
interface Props {
  weekday: number[];
}

const { weekday } = Astro.props;
const LABELS = ['一', '二', '三', '四', '五', '六', '日'];
const active = new Set(weekday);
const ariaLabel = weekday.map((d) => `週${LABELS[d - 1]}`).join('、');
// weekday 為空陣列代表「星期未知」而非「這些天都不收運」,不渲染全暗的星期格——
// 呼叫端負責另外顯示誠實說明(沿用既有版本的既有規則)。
---

{
  weekday.length > 0 && (
    <span class="ui-weekday-badge" aria-label={ariaLabel}>
      {LABELS.map((label, i) => (
        <span class={active.has(i + 1) ? 'wd-on' : 'wd-off'} aria-hidden="true">
          {label}
        </span>
      ))}
    </span>
  )
}

<style>
  .ui-weekday-badge {
    display: inline-grid;
    grid-template-columns: repeat(7, 1.15em);
    font-size: 0.8rem;
  }
  .ui-weekday-badge span {
    text-align: center;
  }
  .wd-on {
    color: var(--color-brand-text);
    font-weight: 700;
  }
  .wd-off {
    color: var(--color-muted);
  }
</style>
