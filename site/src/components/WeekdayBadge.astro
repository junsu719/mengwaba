---
// 固定寬度的星期指示器:不論實際收運日有幾天,永遠佔滿 7 格,避免同一欄因天數不同
// (1 天 vs 5 天)而寬度跳動,導致隔壁的時間欄位對不齊(見 2026-07-21 手機版排版回報)。
interface Props {
  weekday: number[];
}

const { weekday } = Astro.props;
const LABELS = ['一', '二', '三', '四', '五', '六', '日'];
const active = new Set(weekday);
const ariaLabel = weekday.map((d) => `週${LABELS[d - 1]}`).join('、');
// weekday 為空陣列代表「星期未知」而非「這些天都不收運」(見 data.ts ScheduleEntry.weekday 註解),
// 不得渲染全暗的星期格──那看起來像是在宣告「這天都不收」。呼叫端負責另外顯示 F1 的誠實說明。
---

{
  weekday.length > 0 && (
    <span class="weekday-badge" aria-label={ariaLabel}>
      {LABELS.map((label, i) => (
        <span class={active.has(i + 1) ? 'wd-on' : 'wd-off'} aria-hidden="true">
          {label}
        </span>
      ))}
    </span>
  )
}

<style>
  .weekday-badge {
    display: inline-grid;
    grid-template-columns: repeat(7, 1.15em);
    font-size: 0.8rem;
  }
  .weekday-badge span {
    text-align: center;
  }
  .wd-on {
    color: var(--accent);
    font-weight: 700;
  }
  .wd-off {
    /* 2026-09-22 修正(見 DECISIONS.md):原本用 var(--border)(#e2e2e2)當「未收運」的
       文字色,對白底僅約 1.3:1,遠低於 WCAG AA 文字門檻。改用 var(--muted)(#5b5b5b,
       對白底 6.79:1),Phase 3 元件庫盤點時已用 site/src/components/ui/WeekdayBadge.astro
       驗證過這個配色,這裡是同一個修正單獨套用到現行正式頁面。 */
    color: var(--muted);
  }
</style>
