---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const jsonLd = [breadcrumbJsonLd([{ name: '首頁', url: Astro.url.href }])];

const tools = [
  {
    name: '垃圾車清運時間查詢',
    description: '輸入地名查詢全台垃圾車清運時間與地點,依縣市、行政區、清運點分頁整理。',
    href: '/trash/',
    status: 'live' as const,
  },
  {
    name: '勞動權益計算機',
    description: '特休、加班費、資遣費等勞動法規試算工具。',
    href: null,
    status: 'planned' as const,
  },
];
---

<BaseLayout
  title="悶蛙吧 MengWaBa｜台灣生活工具站"
  description="悶蛙吧整理台灣人日常會用到的查詢與試算工具,目前提供全台垃圾車清運時間查詢,更多生活工具陸續上線。"
  jsonLd={jsonLd}
>
  <h1>悶蛙吧 MengWaBa</h1>
  <p>整理台灣人日常會用到的查詢與試算工具,免費使用,持續擴充中。</p>

  <h2>目前提供的工具</h2>
  <ul class="card-grid">
    {
      tools.map((tool) =>
        tool.status === 'live' ? (
          <li>
            <a class="card" href={tool.href!}>
              <strong>{tool.name}</strong>
              <div>{tool.description}</div>
            </a>
          </li>
        ) : (
          <li>
            <div class="card card-disabled">
              <strong>{tool.name}</strong>
              <div>{tool.description}</div>
              <div class="badge">籌備中</div>
            </div>
          </li>
        )
      )
    }
  </ul>

  <p slot="footer">悶蛙吧整理台灣公開資料與生活常識,製作免費查詢與試算工具;各工具的資料來源與免責聲明請見各工具頁面說明。</p>
</BaseLayout>

<style>
  .card-disabled {
    background: #f7f7f7;
    border-style: dashed;
  }
  .card-disabled strong {
    color: var(--muted);
  }
  .badge {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
</style>
