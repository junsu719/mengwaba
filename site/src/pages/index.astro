---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const jsonLd = [breadcrumbJsonLd([{ name: '首頁', url: Astro.url.href }])];

const tools = [
  {
    name: '垃圾車清運時間查詢',
    description: '輸入地名查詢全台垃圾車清運時間與地點,依縣市、行政區、清運點分頁整理。',
    href: '/trash/',
    status: 'live' as const,
  },
  {
    name: '國定假日與連假查詢',
    description: '查詢政府行政機關辦公日曆表,各年度國定假日、補假日、連假起訖日與天數,並提供 .ics 行事曆訂閱。',
    href: '/calendar/',
    status: 'live' as const,
  },
  {
    name: '農民曆查詢',
    description: '查今日農曆、沖煞、宜忌,整理常見神明生日對照國曆日期,並提供農曆生日換算工具。',
    href: '/lunar/',
    status: 'live' as const,
  },
  {
    name: '小遊戲',
    description: '免安裝、免帳號直接玩的瀏覽器小遊戲,目前收錄 3D 九號球撞球。',
    href: '/games/',
    status: 'live' as const,
  },
  {
    name: '勞動權益計算機',
    description: '特休、加班費、資遣費等勞動法規試算工具。',
    href: null,
    status: 'planned' as const,
  },
];
---

<BaseLayout
  title="悶蛙吧 MengWaBa｜台灣生活工具站"
  description="悶蛙吧整理台灣人日常會用到的查詢與試算工具,目前提供全台垃圾車清運時間查詢、國定假日與連假查詢、農民曆查詢,更多生活工具陸續上線。"
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>悶蛙吧</h1>
    <p class="tagline">台灣人的生活小工具箱</p>
    <p class="hero-copy">生活有點麻煩,來悶蛙吧。</p>
  </section>

  <h2>目前提供的工具</h2>
  <ul class="tool-grid">
    {
      tools.map((tool) => (
        <li>
          {tool.status === 'live' ? (
            <Card variant="tool" href={tool.href!}>
              <strong class="tool-name">{tool.name}</strong>
              <p class="tool-desc">{tool.description}</p>
            </Card>
          ) : (
            <Card variant="tool">
              <strong class="tool-name tool-name--disabled">{tool.name}</strong>
              <p class="tool-desc">{tool.description}</p>
              <span class="badge">籌備中</span>
            </Card>
          )}
        </li>
      ))
    }
  </ul>

  <p slot="footer">悶蛙吧整理台灣公開資料與生活常識,製作免費查詢與試算工具;各工具的資料來源與免責聲明請見各工具頁面說明。</p>
</BaseLayout>

<style>
  .hero {
    padding: var(--spacing-xl) 0 var(--spacing-lg);
  }
  .hero h1 {
    margin: 0 0 var(--spacing-xs);
    font-size: 2rem;
    color: var(--color-brand-text);
  }
  .tagline {
    margin: 0 0 var(--spacing-sm);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero-copy {
    margin: 0;
    color: var(--color-muted);
  }
  .tool-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-md);
  }
  .tool-grid > li {
    display: flex;
  }
  .tool-grid > li > :global(.ui-card) {
    flex: 1;
  }
  .tool-name {
    display: block;
    font-size: 1.05rem;
    color: var(--color-ink);
  }
  .tool-name--disabled {
    color: var(--color-muted);
  }
  .tool-desc {
    margin: var(--spacing-xs) 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .badge {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }
</style>
