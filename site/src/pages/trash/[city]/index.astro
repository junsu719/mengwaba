---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SearchBox from '../../../components/SearchBox.astro';
import { CITIES, groupByDistrict, type CityInfo } from '../../../lib/data';
import { loadCityPoints } from '../../../lib/data-static';
import { breadcrumbJsonLd } from '../../../lib/seo';

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: CityInfo };
const points = loadCityPoints(city.file);
const districts = groupByDistrict(points);

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
    { name: city.name, url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title={`${city.name}垃圾車清運時間查詢｜各行政區清運時刻總表`}
  description={`${city.name}全區垃圾車清運時間查詢,涵蓋 ${districts.length} 個行政區、${points.length} 個清運點,點選行政區查看該區完整時刻表。`}
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / <a href="/trash/">垃圾車清運時間查詢</a> / {city.name}</nav>
  <h1>{city.name}垃圾車清運時間查詢</h1>
  <p>
    {city.name}共有 {districts.length} 個行政區、{points.length.toLocaleString('zh-Hant-TW')} 個垃圾車定點清運點資料。點選下方行政區,查看該區所有清運點與時刻總表。
  </p>

  <SearchBox indexUrl={`/trash/${city.slug}/search-index.json`} />

  <ul class="card-grid">
    {
      districts.map((g) => (
        <li>
          <a class="card" href={`/trash/${city.slug}/${g.districtSlug}/`}>
            <strong>{g.district}</strong>
            <div>{g.points.length} 個清運點</div>
          </a>
        </li>
      ))
    }
  </ul>

  <p slot="footer">
    資料來源:{city.sourceName}(<a href={city.sourceUrl} rel="noopener">{city.name}政府資料開放平台</a>),依「政府資料開放授權條款第1版」提供。
  </p>
  <p slot="footer">本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
</BaseLayout>
