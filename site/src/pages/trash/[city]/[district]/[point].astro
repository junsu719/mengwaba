---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  CITIES,
  parsePointId,
  nearestPoints,
  isWeekdayUnknown,
  getCity,
  type CollectionPoint,
  type CityInfo,
} from '../../../../lib/data';
import {
  buildPointId,
  loadPointById,
  loadDistrictDisplayName,
  loadNearbyCandidates,
  lookupLegacyRedirect,
  isLegacyPointSlug,
} from '../../../../lib/data-d1';
import { breadcrumbJsonLd, faqPageJsonLd, placeJsonLd } from '../../../../lib/seo';
import {
  todaySummarySentence,
  introSentence,
  buildFaq,
  scheduleTimeText,
  weekdayUnknownNotice,
  officialQuerySystem,
} from '../../../../lib/content';
import WeekdayBadge from '../../../../components/WeekdayBadge.astro';
import NotFoundContent from '../../../../components/NotFoundContent.astro';

// 2026-08-25 D1 額度優化(見 DECISIONS.md):本頁原本借用行政區頁的「整區」查詢(loadDistrictFromD1)
// 來找單一清運點,理由是「鄰近清運點」天生要同區其他點——但這也是 D1 免費額度(500 萬 rows/天)
// 超額 3 倍以上的主因(單一查詢佔總讀取量 87%,板橋等大行政區單次請求就讀進 6,000+ 列)。改為:
// 目標點用 point_id(PK)直接查(rows_read=1),鄰近點改用限量候選集(見 data-d1.ts
// loadNearbyCandidates 註解:優先同村里、不足才擴大整區但仍有上限),而非整個行政區。

const { city: citySlug, district: districtSlug, point: pointSlug } = Astro.params;

const db = (env as unknown as { POINTS_DB?: unknown }).POINTS_DB;
if (!db) {
  return new Response('D1 binding 未設定(POINTS_DB)', { status: 500 });
}

// 2026-07-28 拍板(見 DECISIONS.md):找不到清運點時,維持真正的 HTTP 404(不得改 200
// 或導向其他頁面,軟性 404 對 SEO 更糟),但改用 NotFoundContent 渲染有用的頁面內容,
// 而不是純文字「Not Found」——高雄有 269 個舊格式網址在現行資料裡查無對應,301 修復
// 上線後 Google 仍會持續帶使用者撞上這批網址。city/districtName 能解析出多少就帶多少
// context 進 NotFoundContent(例如「行政區清運點列表」連結),解析不出來的就交給它退回通用版本。
let city: CityInfo | null = null;
let point: CollectionPoint | null = null;
// 行政區顯示名稱:找到點時直接用該點的 district 欄位,不需要再查一次;找不到點時才用
// loadDistrictDisplayName 額外查(LIMIT 1,不撈整區),供 404 頁面帶 context。
let districtName: string | null = null;

if (CITIES.some((c) => c.slug === citySlug)) {
  city = getCity(citySlug!);

  // 舊格式(全域流水號)pointSlug 的 301 導向:2026-07-22 point_id 改內容雜湊方案後,
  // 已被 Google 索引的舊網址全數 404(見 DECISIONS.md 2026-07-28 事故記錄)。純數字 pointSlug
  // 是舊格式的明確特徵(新雜湊 pointSlug 一律含字母,兩者不重疊),查得到就 301 到現行網址
  // (用新 point_id 解析出的行政區,避免行政區本身也變動時導向到錯誤網址)。
  if (isLegacyPointSlug(pointSlug!)) {
    const newPointId = await lookupLegacyRedirect(db as never, citySlug!, districtSlug!, pointSlug!);
    if (newPointId) {
      const parsed = parsePointId(newPointId);
      if (parsed) {
        return Astro.redirect(`/trash/${citySlug}/${parsed.districtSlug}/${parsed.pointSlug}/`, 301);
      }
    }
    // 查無對應:不在這裡直接回 404,讓流程繼續往下走一般查詢路徑——這個 pointSlug 不會
    // 比對到任何現有點,自然落入下方 point 為 null 的分支,且該分支已有 districtName
    // context 可用,可以組出比純文字 404 更有用的內容,不猜測配對到其他點。
  }

  // buildPointId 組不出 point_id(未知縣市前綴)時 pointId 為 null,point 維持 null,
  // 落入下方一般 404 分支——理論上不會發生(citySlug 已通過 CITIES 檢查),防禦性寫法。
  const pointId = buildPointId(citySlug!, districtSlug!, pointSlug!);
  if (pointId) {
    point = await loadPointById(db as never, pointId);
  }
  districtName = point ? point.district : await loadDistrictDisplayName(db as never, citySlug!, districtSlug!);
}

if (!point) {
  Astro.response.status = 404;
}

const pageUrl = Astro.url.href;
const nearbyCandidates = point
  ? await loadNearbyCandidates(db as never, citySlug!, districtSlug!, point.village, point.point_id)
  : [];
const nearby = point ? nearestPoints(point, nearbyCandidates, 5) : [];
const faq = point && districtName ? buildFaq(point, districtName) : [];
const hasRecycling = !!point?.recycling_schedule && point.recycling_schedule.length > 0;
const hasFoodscraps = !!point?.foodscraps_schedule && point.foodscraps_schedule.length > 0;
const scheduleWeekdayUnknown = point ? point.schedule.some(isWeekdayUnknown) : false;
const recyclingWeekdayUnknown = hasRecycling && point!.recycling_schedule!.some(isWeekdayUnknown);
const foodscrapsWeekdayUnknown = hasFoodscraps && point!.foodscraps_schedule!.some(isWeekdayUnknown);

const title =
  point && city && districtName
    ? `${point.point_name}垃圾車時間｜${city.name}${districtName}清運時刻查詢`
    : '找不到這個清運點｜悶蛙吧 MengWaBa';
const description = point
  ? introSentence(point)
  : '這個網址對應的清運點可能已停止服務,或資料來源已更新調整,可透過搜尋或行政區列表查詢其他清運點。';

const jsonLd =
  point && city && districtName
    ? [
        breadcrumbJsonLd([
          { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
          { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
          { name: city.name, url: new URL(`/trash/${city.slug}/`, Astro.site ?? Astro.url).href },
          { name: districtName, url: new URL(`/trash/${city.slug}/${districtSlug}/`, Astro.site ?? Astro.url).href },
          { name: point.point_name ?? point.point_id, url: pageUrl },
        ]),
        faqPageJsonLd(faq),
        placeJsonLd(point, pageUrl),
      ].filter(Boolean)
    : [];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  {
    point && city && districtName ? (
      <>
        <nav>
          <a href="/">首頁</a> / <a href="/trash/">垃圾車清運時間查詢</a> /{' '}
          <a href={`/trash/${city.slug}/`}>{city.name}</a> /{' '}
          <a href={`/trash/${city.slug}/${districtSlug}/`}>{districtName}</a> / {point.point_name}
        </nav>

        <h1>{point.point_name}垃圾車時間</h1>

        <p class="today-answer">{todaySummarySentence(point)}</p>

        <p>{introSentence(point)}</p>

        {
          // I1(2026-07-27 拍板):純資源回收點 point.schedule 為空陣列,不渲染這整個區塊——
          // 空的 <tbody> 只會產生一個沒有任何列的殘缺表格,對使用者沒有意義。
          point.schedule.length > 0 && (
            <>
              <h2>本週時刻表</h2>
              {scheduleWeekdayUnknown && (
                <p class="weekday-unknown-notice">
                  {weekdayUnknownNotice(point)}
                  {officialQuerySystem(point) && (
                    <>
                      {' '}
                      <a href={officialQuerySystem(point)!.url} rel="noopener" target="_blank">
                        前往查詢
                      </a>
                    </>
                  )}
                </p>
              )}
              <table class="schedule-table">
                <colgroup>
                  <col class="col-weekday" />
                  <col class="col-time" />
                </colgroup>
                <thead>
                  <tr>
                    <th>收運日</th>
                    <th>時間</th>
                  </tr>
                </thead>
                <tbody>
                  {point.schedule.map((s) => (
                    <tr>
                      <td>{s.weekday.length > 0 ? <WeekdayBadge weekday={s.weekday} /> : '—'}</td>
                      <td>{scheduleTimeText(s, point.collection_type)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        {
          hasRecycling && (
            <>
              <h2>資源回收時刻</h2>
              {recyclingWeekdayUnknown && (
                <p class="weekday-unknown-notice">
                  {weekdayUnknownNotice(point, '回收')}
                  {officialQuerySystem(point) && (
                    <>
                      {' '}
                      <a href={officialQuerySystem(point)!.url} rel="noopener" target="_blank">
                        前往查詢
                      </a>
                    </>
                  )}
                </p>
              )}
              <table class="schedule-table">
                <colgroup>
                  <col class="col-weekday" />
                  <col class="col-time" />
                </colgroup>
                <thead>
                  <tr>
                    <th>回收日</th>
                    <th>時間</th>
                  </tr>
                </thead>
                <tbody>
                  {point.recycling_schedule!.map((s) => (
                    <tr>
                      <td>{s.weekday.length > 0 ? <WeekdayBadge weekday={s.weekday} /> : '—'}</td>
                      <td>{scheduleTimeText(s, point.collection_type)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        {
          hasFoodscraps && (
            <>
              <h2>廚餘回收時刻</h2>
              <p class="foodscraps-notice">
                廚餘收運到站時間多與上方一般垃圾／資源回收時刻表一致,下表僅列出有提供廚餘回收的星期。
              </p>
              {foodscrapsWeekdayUnknown && (
                <p class="weekday-unknown-notice">
                  {weekdayUnknownNotice(point, '廚餘回收')}
                  {officialQuerySystem(point) && (
                    <>
                      {' '}
                      <a href={officialQuerySystem(point)!.url} rel="noopener" target="_blank">
                        前往查詢
                      </a>
                    </>
                  )}
                </p>
              )}
              <table class="schedule-table">
                <colgroup>
                  <col class="col-weekday" />
                  <col class="col-time" />
                </colgroup>
                <thead>
                  <tr>
                    <th>收運日</th>
                    <th>時間</th>
                  </tr>
                </thead>
                <tbody>
                  {point.foodscraps_schedule!.map((s) => (
                    <tr>
                      <td>{s.weekday.length > 0 ? <WeekdayBadge weekday={s.weekday} /> : '—'}</td>
                      <td>{scheduleTimeText(s, point.collection_type)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        <style>
          .schedule-table {
            table-layout: fixed;
          }
          .col-weekday {
            width: 8rem;
          }
          .schedule-table td {
            white-space: nowrap;
          }
        </style>

        {
          point.collection_type && (
            <>
              <h2>清運方式</h2>
              <p>
                {point.collection_type}。{point.notes ? point.notes : ''}
              </p>
            </>
          )
        }

        {point.address && <p>地址參考:{point.address}</p>}

        <h2>鄰近清運點</h2>
        <ul class="plain">
          {nearby.map((n) => {
            const nearbyPointSlug = parsePointId(n.point_id)?.pointSlug;
            const entry = n.schedule[0];
            return (
              <li>
                {
                  // point_id 格式異常時無法組出合法連結,退化為純文字顯示,不拿掉整筆資訊、也不讓整頁崩潰
                  nearbyPointSlug ? (
                    <a href={`/trash/${city.slug}/${districtSlug}/${nearbyPointSlug}/`}>{n.point_name}</a>
                  ) : (
                    <span>{n.point_name}</span>
                  )
                }
                {entry ? `・${scheduleTimeText(entry, n.collection_type)}` : ''}
              </li>
            );
          })}
        </ul>

        <h2>{districtName}注意事項</h2>
        <p>
          請將垃圾裝入合格垃圾袋,於垃圾車抵達前在定點等候,避免提早棄置造成環境問題;資源回收請分類後交給清潔隊員。若時刻有異動,請以
          {city.name}政府環境保護局公告為準。
        </p>

        <h2>常見問題</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </>
    ) : (
      <NotFoundContent
        district={
          city && districtName
            ? { cityName: city.name, citySlug: city.slug, districtName, districtSlug: districtSlug! }
            : undefined
        }
      />
    )
  }
  {
    // footer slot 獨立於上方主內容的 ternary 之外(2026-07-28 除錯記錄:曾經包在同一個
    // ternary/fragment 裡,結果 Astro 把整段誤判成單一 slot 內容,導致 <main> 整段變空、
    // NotFoundContent 連同 footer 文字一起被塞進 <footer>)。這個 Fragment 本身一律
    // 無條件存在(slot="footer" 屬性不能被 `{cond && ...}` 包住否則永遠不會 render——
    // 同樣是除錯時發現:即使條件為 false,Astro 仍判定 footer slot「已由外層提供內容」,
    // 導致 BaseLayout 自己的預設 fallback 文案也不會顯示,footer 整個變空),只有裡面
    // 的文字內容依 point 是否存在做條件切換。
  }
  <Fragment slot="footer">
    {
      point && city ? (
        <>
          <p>
            資料來源:{city.sourceName}(
            <a href={city.sourceUrl} rel="noopener">
              {city.name}政府資料開放平台
            </a>
            ),依「政府資料開放授權條款第1版」提供。
          </p>
          <p>本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
        </>
      ) : (
        <>
          <p>資料來源:各縣市政府資料開放平台,依「政府資料開放授權條款第1版」提供,各頁面詳細來源請見頁面內標註。</p>
          <p>本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
        </>
      )
    }
  </Fragment>
</BaseLayout>
