---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { CITIES, parsePointId, nearestPoints, todayScheduleEntry, todayWeekdayTaipei, getCity } from '../../../../lib/data';
import { loadDistrictFromD1, toDistrictGroup } from '../../../../lib/data-d1';
import { breadcrumbJsonLd, faqPageJsonLd, placeJsonLd } from '../../../../lib/seo';
import { todaySummarySentence, introSentence, buildFaq, scheduleTimeText } from '../../../../lib/content';
import WeekdayBadge from '../../../../components/WeekdayBadge.astro';

// Phase 4.5 Step 4:清運點頁改 on-demand D1 查詢(見 phase4.5-hybrid-rendering-spec.md §3)。
// 與行政區頁共用同一支「查整個行政區」的 D1 查詢——本頁的「鄰近清運點」需要同區其他點,
// 天生沒有「只查單一點」的路徑,見 d1/schema.sql 註解。

const { city: citySlug, district: districtSlug, point: pointSlug } = Astro.params;

if (!CITIES.some((c) => c.slug === citySlug)) {
  return new Response('Not Found', { status: 404 });
}
const city = getCity(citySlug!);

const db = (env as unknown as { POINTS_DB?: unknown }).POINTS_DB;
if (!db) {
  return new Response('D1 binding 未設定(POINTS_DB)', { status: 500 });
}

const districtPoints = await loadDistrictFromD1(db as never, citySlug!, districtSlug!);
const group = toDistrictGroup(districtPoints, districtSlug!);
if (!group) {
  return new Response('Not Found', { status: 404 });
}

// point_id 解析失敗的點視同不比對(parsePointId 回傳 null 時 optional chaining 短路為 undefined,
// 不等於任何合法 pointSlug),自然落入下方既有的 404 分支,不會額外崩潰。
const point = group.points.find((p) => parsePointId(p.point_id)?.pointSlug === pointSlug);
if (!point) {
  return new Response('Not Found', { status: 404 });
}

const nearby = nearestPoints(point, group.points, 5);
const faq = buildFaq(point, group.district);
const weekday = todayWeekdayTaipei();
const todayEntry = todayScheduleEntry(point, weekday);
const pageUrl = Astro.url.href;
const hasRecycling = !!point.recycling_schedule && point.recycling_schedule.length > 0;

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
    { name: city.name, url: new URL(`/trash/${city.slug}/`, Astro.site ?? Astro.url).href },
    { name: group.district, url: new URL(`/trash/${city.slug}/${group.districtSlug}/`, Astro.site ?? Astro.url).href },
    { name: point.point_name ?? point.point_id, url: pageUrl },
  ]),
  faqPageJsonLd(faq),
  placeJsonLd(point, pageUrl),
].filter(Boolean);
---

<BaseLayout
  title={`${point.point_name}垃圾車時間｜${city.name}${group.district}清運時刻查詢`}
  description={introSentence(point)}
  jsonLd={jsonLd}
>
  <nav>
    <a href="/">首頁</a> / <a href="/trash/">垃圾車清運時間查詢</a> / <a href={`/trash/${city.slug}/`}>{city.name}</a> / <a href={`/trash/${city.slug}/${group.districtSlug}/`}>{group.district}</a> / {point.point_name}
  </nav>

  <h1>{point.point_name}垃圾車時間</h1>

  <p class="today-answer">{todaySummarySentence(point)}</p>

  <p>{introSentence(point)}</p>

  <h2>本週時刻表</h2>
  <table class="schedule-table">
    <colgroup>
      <col class="col-weekday" />
      <col class="col-time" />
    </colgroup>
    <thead>
      <tr>
        <th>收運日</th>
        <th>時間</th>
      </tr>
    </thead>
    <tbody>
      {
        point.schedule.map((s) => (
          <tr>
            <td><WeekdayBadge weekday={s.weekday} /></td>
            <td>{scheduleTimeText(s, point.collection_type)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    hasRecycling && (
      <>
        <h2>資源回收時刻</h2>
        <table class="schedule-table">
          <colgroup>
            <col class="col-weekday" />
            <col class="col-time" />
          </colgroup>
          <thead>
            <tr>
              <th>回收日</th>
              <th>時間</th>
            </tr>
          </thead>
          <tbody>
            {point.recycling_schedule!.map((s) => (
              <tr>
                <td><WeekdayBadge weekday={s.weekday} /></td>
                <td>{scheduleTimeText(s, point.collection_type)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  <style>
    .schedule-table {
      table-layout: fixed;
    }
    .col-weekday {
      width: 8rem;
    }
    .schedule-table td {
      white-space: nowrap;
    }
  </style>

  <h2>清運方式</h2>
  <p>{point.collection_type}。{point.notes ? point.notes : ''}</p>

  {point.address && <p>地址參考:{point.address}</p>}

  <h2>鄰近清運點</h2>
  <ul class="plain">
    {
      nearby.map((n) => {
        const pointSlug = parsePointId(n.point_id)?.pointSlug;
        const entry = n.schedule[0];
        return (
          <li>
            {
              // point_id 格式異常時無法組出合法連結,退化為純文字顯示,不拿掉整筆資訊、也不讓整頁崩潰
              pointSlug ? (
                <a href={`/trash/${city.slug}/${group.districtSlug}/${pointSlug}/`}>{n.point_name}</a>
              ) : (
                <span>{n.point_name}</span>
              )
            }
            {entry ? `・${scheduleTimeText(entry, n.collection_type)}` : ''}
          </li>
        );
      })
    }
  </ul>

  <h2>{group.district}注意事項</h2>
  <p>
    請將垃圾裝入合格垃圾袋,於垃圾車抵達前在定點等候,避免提早棄置造成環境問題;資源回收請分類後交給清潔隊員。若時刻有異動,請以
    {city.name}政府環境保護局公告為準。
  </p>

  <h2>常見問題</h2>
  {
    faq.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))
  }

  <p slot="footer">
    資料來源:{city.sourceName}(<a href={city.sourceUrl} rel="noopener">{city.name}政府資料開放平台</a>),依「政府資料開放授權條款第1版」提供。
  </p>
  <p slot="footer">本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
</BaseLayout>
