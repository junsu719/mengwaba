---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  loadKaohsiungPoints,
  groupByDistrict,
  parsePointId,
  nearestPoints,
  todayScheduleEntry,
  todayWeekdayTaipei,
  WEEKDAY_NAMES,
  CITY_SLUG,
  CITY_NAME,
  type CollectionPoint,
  type DistrictGroup,
} from '../../../../lib/data';
import { breadcrumbJsonLd, faqPageJsonLd, placeJsonLd } from '../../../../lib/seo';
import { todaySummarySentence, introSentence, buildFaq } from '../../../../lib/content';

export function getStaticPaths() {
  const points = loadKaohsiungPoints();
  const districts = groupByDistrict(points);
  return districts.flatMap((g: DistrictGroup) =>
    g.points.map((p: CollectionPoint) => {
      const { pointSlug } = parsePointId(p.point_id);
      return {
        params: { city: CITY_SLUG, district: g.districtSlug, point: pointSlug },
        props: { point: p, group: g },
      };
    })
  );
}

const { point, group } = Astro.props as { point: CollectionPoint; group: DistrictGroup };

const nearby = nearestPoints(point, group.points, 5);
const faq = buildFaq(point, group.district);
const weekday = todayWeekdayTaipei();
const todayEntry = todayScheduleEntry(point, weekday);
const pageUrl = Astro.url.href;

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
    { name: CITY_NAME, url: new URL(`/trash/${CITY_SLUG}/`, Astro.site ?? Astro.url).href },
    { name: group.district, url: new URL(`/trash/${CITY_SLUG}/${group.districtSlug}/`, Astro.site ?? Astro.url).href },
    { name: point.point_name ?? point.point_id, url: pageUrl },
  ]),
  faqPageJsonLd(faq),
  placeJsonLd(point, pageUrl),
].filter(Boolean);
---

<BaseLayout
  title={`${point.point_name}垃圾車時間｜${CITY_NAME}${group.district}清運時刻查詢`}
  description={introSentence(point)}
  jsonLd={jsonLd}
>
  <nav>
    <a href="/">首頁</a> / <a href={`/trash/${CITY_SLUG}/`}>{CITY_NAME}</a> / <a href={`/trash/${CITY_SLUG}/${group.districtSlug}/`}>{group.district}</a> / {point.point_name}
  </nav>

  <h1>{point.point_name}垃圾車時間</h1>

  <p class="today-answer">{todaySummarySentence(point)}</p>

  <p>{introSentence(point)}</p>

  <h2>本週時刻表</h2>
  <table>
    <thead>
      <tr>
        <th>收運日</th>
        <th>到站</th>
        <th>離站</th>
      </tr>
    </thead>
    <tbody>
      {
        point.schedule.map((s) => (
          <tr>
            <td>{s.weekday.map((d) => `週${WEEKDAY_NAMES[d]}`).join('、')}</td>
            <td>{s.arrive}</td>
            <td>{s.depart}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>清運方式</h2>
  <p>{point.collection_type}。{point.notes ? point.notes : ''}</p>

  {point.address && <p>地址參考:{point.address}</p>}

  <h2>鄰近清運點</h2>
  <ul class="plain">
    {
      nearby.map((n) => {
        const { pointSlug } = parsePointId(n.point_id);
        const entry = n.schedule[0];
        return (
          <li>
            <a href={`/trash/${CITY_SLUG}/${group.districtSlug}/${pointSlug}/`}>{n.point_name}</a>
            {entry ? `・${entry.arrive}〜${entry.depart}` : ''}
          </li>
        );
      })
    }
  </ul>

  <h2>{group.district}注意事項</h2>
  <p>
    請將垃圾裝入合格垃圾袋,於垃圾車抵達前在定點等候,避免提早棄置造成環境問題;資源回收請分類後交給清潔隊員。若時刻有異動,請以
    高雄市政府環境保護局公告為準。
  </p>

  <h2>常見問題</h2>
  {
    faq.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))
  }
</BaseLayout>
