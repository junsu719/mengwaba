---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { CITIES, loadCityPoints, groupByDistrict, parsePointId, type CityInfo, type DistrictGroup } from '../../../../lib/data';
import { breadcrumbJsonLd } from '../../../../lib/seo';
import { districtNoteSentence, scheduleTimeText, weekdayListText } from '../../../../lib/content';

export function getStaticPaths() {
  return CITIES.flatMap((city) => {
    const points = loadCityPoints(city.file);
    const districts = groupByDistrict(points);
    return districts.map((g) => ({
      params: { city: city.slug, district: g.districtSlug },
      props: { group: g, city },
    }));
  });
}

const { group, city } = Astro.props as { group: DistrictGroup; city: CityInfo };

const sortedByTime = [...group.points].sort((a, b) => {
  const at = a.schedule[0]?.arrive ?? '99:99';
  const bt = b.schedule[0]?.arrive ?? '99:99';
  return at.localeCompare(bt);
});

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
    { name: city.name, url: new URL(`/trash/${city.slug}/`, Astro.site ?? Astro.url).href },
    { name: group.district, url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title={`${group.district}垃圾車時間查詢｜${city.name}${group.district}清運點總表`}
  description={`${city.name}${group.district}垃圾車清運時間總表,共 ${group.points.length} 個清運點,依到站時間排序,點選查看各點詳細時刻與地址。`}
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / <a href="/trash/">垃圾車清運時間查詢</a> / <a href={`/trash/${city.slug}/`}>{city.name}</a> / {group.district}</nav>
  <h1>{group.district}垃圾車清運時間查詢</h1>
  <p>{districtNoteSentence(group)}</p>

  <h2>清運點列表</h2>
  <ul class="plain">
    {
      group.points.map((p) => {
        const { pointSlug } = parsePointId(p.point_id);
        return (
          <li>
            <a href={`/trash/${city.slug}/${group.districtSlug}/${pointSlug}/`}>{p.point_name}</a>
            {p.village ? ` ・${p.village}` : ''}
          </li>
        );
      })
    }
  </ul>

  <h2>時段總表(依到站時間排序)</h2>
  <table>
    <thead>
      <tr>
        <th>收運時間</th>
        <th>清運點</th>
        <th>里別</th>
        <th>收運日</th>
      </tr>
    </thead>
    <tbody>
      {
        sortedByTime.map((p) => {
          const { pointSlug } = parsePointId(p.point_id);
          const entry = p.schedule[0];
          return (
            <tr>
              <td>{entry ? scheduleTimeText(entry, p.collection_type) : '—'}</td>
              <td>
                <a href={`/trash/${city.slug}/${group.districtSlug}/${pointSlug}/`}>{p.point_name}</a>
              </td>
              <td>{p.village ?? '—'}</td>
              <td>{entry ? weekdayListText(entry.weekday) : '—'}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  <p slot="footer">
    資料來源:{city.sourceName}(<a href={city.sourceUrl} rel="noopener">{city.name}政府資料開放平台</a>),依「政府資料開放授權條款第1版」提供。
  </p>
  <p slot="footer">本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
</BaseLayout>
