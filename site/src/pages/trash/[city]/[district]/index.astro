---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  CITIES,
  WEEKDAY_NAMES,
  parsePointId,
  groupByDistrict,
  groupByVillage,
  computeDistrictStats,
  fetchedAtDateRange,
  type CityInfo,
  type DistrictGroup,
  type CollectionPoint,
} from '../../../../lib/data';
import { loadCityPoints } from '../../../../lib/data-static';
import { breadcrumbJsonLd } from '../../../../lib/seo';
import {
  districtNoteSentence,
  scheduleTimeText,
  buildDistrictFaq,
  weekdaySummarySentence,
  weekdayDistributionCaveat,
  districtTimeDistributionSentence,
} from '../../../../lib/content';
import WeekdayBadge from '../../../../components/WeekdayBadge.astro';

// 2026-08-28 拍板(見 DECISIONS.md):行政區頁改回完全靜態預生成,不再 on-demand 查 D1。
// 背景:8/25-8/27 已陸續拆掉本頁借用的全區/全縣市規模 D1 查詢(見 692a1fb9、13ab45c8),
// 拆到最後這頁對 D1 只剩「單一行政區」規模的查詢——但全台行政區頁數量本身是有限集合
// (現行已上線縣市 + 全台 22 縣市擴充後合計數百頁),與清運點頁(數萬頁,必須 on-demand
// 才能繞開 Cloudflare 部署檔案數上限)不同,完全在靜態預生成可負擔的範圍內。改回靜態後
// 這頁的 D1 讀取額度歸零,且不受 D1 額度重演同類事故影響;縣市/行政區組合改在 build 時
// 窮舉(getStaticPaths),不再於 request 時查驗。清運點頁維持 on-demand D1(見該檔案開頭
// 註解),不受此變動影響。
//
// 靜態化後的重要影響:季度資料更新(fetch → normalize → validate → 推送 D1)後,行政區頁
// 需要額外重新 build + deploy 才會反映新資料,不像清運點頁下次請求就自動拿到最新 D1 內容
// ——已記錄進 CLAUDE.md「資料更新與機器角色」與 DECISIONS.md 2026-08-28 條目,避免流程
// 遺漏導致行政區頁停在舊資料且無錯誤訊息。

export function getStaticPaths() {
  return CITIES.flatMap((city) => {
    const points = loadCityPoints(city.file);
    const districts = groupByDistrict(points);
    return districts.map((group) => ({
      params: { city: city.slug, district: group.districtSlug },
      props: {
        city,
        group,
        siblingDistricts: districts
          .filter((d) => d.districtSlug !== group.districtSlug)
          .map((d) => ({ district: d.district, districtSlug: d.districtSlug })),
      },
    }));
  });
}

const { city, group, siblingDistricts } = Astro.props as {
  city: CityInfo;
  group: DistrictGroup;
  siblingDistricts: { district: string; districtSlug: string }[];
};

// 2026-08-10 行政區頁強化(GSC 130 個行政區頁集中收錄策略,見 DECISIONS.md):以下皆為
// 從既有資料聚合而來的計算,不新增網址、不引入外部資料。
const stats = computeDistrictStats(group.points);
const villages = groupByVillage(group.points);
const unassignedPoints = group.points.filter((p) => !p.village);
const dateRange = fetchedAtDateRange(group.points);
const faq = buildDistrictFaq(group, stats);
const weekdaySummary = weekdaySummarySentence(stats);
const weekdayCaveat = weekdayDistributionCaveat(stats);
const timeDistSentence = districtTimeDistributionSentence(stats);

function pointHref(p: CollectionPoint): string | null {
  const pointSlug = parsePointId(p.point_id)?.pointSlug;
  return pointSlug ? `/trash/${city.slug}/${group.districtSlug}/${pointSlug}/` : null;
}

const sortedByTime = [...group.points].sort((a, b) => {
  const at = a.schedule[0]?.arrive ?? '99:99';
  const bt = b.schedule[0]?.arrive ?? '99:99';
  return at.localeCompare(bt);
});

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: new URL('/trash/', Astro.site ?? Astro.url).href },
    { name: city.name, url: new URL(`/trash/${city.slug}/`, Astro.site ?? Astro.url).href },
    { name: group.district, url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title={`${group.district}垃圾車時間表｜${city.name}清運點查詢｜悶蛙吧`}
  description={`${city.name}${group.district}垃圾車清運時間總表,共 ${group.points.length} 個清運點,分布在 ${stats.villageCount} 個里,依到站時間排序,點選查看各點詳細時刻與地址。`}
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / <a href="/trash/">垃圾車清運時間查詢</a> / <a href={`/trash/${city.slug}/`}>{city.name}</a> / {group.district}</nav>
  <h1>{group.district}垃圾車清運時間查詢</h1>
  <p>{districtNoteSentence(group)}</p>

  {
    villages.length > 0 && (
      <>
        <h2>里別索引</h2>
        <ul class="chip-list">
          {villages.map((v) => (
            <li>
              <a href={`#li-${v.village}`}>
                {v.village}({v.points.length})
              </a>
            </li>
          ))}
          {unassignedPoints.length > 0 && (
            <li>
              <a href="#li-unassigned">未標示里別({unassignedPoints.length})</a>
            </li>
          )}
        </ul>
      </>
    )
  }

  <h2>清運點列表</h2>
  {
    villages.map((v) => (
      <section id={`li-${v.village}`}>
        <h3>
          {v.village}({v.points.length} 個點)
        </h3>
        <ul class="plain">
          {v.points.map((p) => {
            const href = pointHref(p);
            return <li>{href ? <a href={href}>{p.point_name}</a> : <span>{p.point_name}</span>}</li>;
          })}
        </ul>
      </section>
    ))
  }
  {
    unassignedPoints.length > 0 && (
      <section id="li-unassigned">
        <h3>未標示里別({unassignedPoints.length} 個點)</h3>
        <ul class="plain">
          {unassignedPoints.map((p) => {
            const href = pointHref(p);
            return <li>{href ? <a href={href}>{p.point_name}</a> : <span>{p.point_name}</span>}</li>;
          })}
        </ul>
      </section>
    )
  }

  <h2>時段總表(依到站時間排序)</h2>
  <table>
    <thead>
      <tr>
        <th>收運時間</th>
        <th>清運點</th>
        <th>里別</th>
        <th>收運日</th>
      </tr>
    </thead>
    <tbody>
      {
        sortedByTime.map((p) => {
          const href = pointHref(p);
          const entry = p.schedule[0];
          return (
            <tr>
              <td>{entry ? scheduleTimeText(entry, p.collection_type) : '—'}</td>
              <td>{href ? <a href={href}>{p.point_name}</a> : <span>{p.point_name}</span>}</td>
              <td>{p.village || '—'}</td>
              <td>{entry && entry.weekday.length > 0 ? <WeekdayBadge weekday={entry.weekday} /> : '—'}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  <h2>星期分佈總覽</h2>
  {weekdaySummary && <p>{weekdaySummary}</p>}
  <table>
    <thead>
      <tr>
        <th>星期</th>
        <th>清運點數</th>
      </tr>
    </thead>
    <tbody>
      {
        WEEKDAY_NAMES.slice(1).map((name, i) => (
          <tr>
            <td>週{name}</td>
            <td>{stats.weekdayScheduleCounts[i + 1]}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {weekdayCaveat && <p class="muted">{weekdayCaveat}</p>}

  {
    timeDistSentence && (
      <>
        <h2>時段分佈</h2>
        <p>{timeDistSentence}</p>
      </>
    )
  }

  {
    (stats.recyclingPointCount > 0 || stats.foodscrapsPointCount > 0) && (
      <>
        <h2>資源回收/廚餘覆蓋概況</h2>
        <ul class="plain">
          {stats.recyclingPointCount > 0 && (
            <li>
              資源回收:{stats.recyclingPointCount} 個點提供(約 {stats.recyclingCoveragePct}%)
            </li>
          )}
          {stats.foodscrapsPointCount > 0 && (
            <li>
              廚餘回收:{stats.foodscrapsPointCount} 個點提供(約 {stats.foodscrapsCoveragePct}%)
            </li>
          )}
        </ul>
      </>
    )
  }

  {
    faq.length > 0 && (
      <>
        <h2>常見問題</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </>
    )
  }

  <h2>資料來源與更新日期</h2>
  <p>
    資料來源:{city.sourceName}(
    <a href={city.sourceUrl} rel="noopener">
      {city.name}政府資料開放平台
    </a>
    ),依「政府資料開放授權條款第1版」提供。資料更新於 {dateRange.min === dateRange.max ? dateRange.min : `${dateRange.min} ~ ${dateRange.max}`}。
  </p>

  <h2>站內連結</h2>
  <ul class="plain">
    <li>
      <a href={`/trash/${city.slug}/`}>{city.name}行政區索引</a>
    </li>
    <li>
      <a href="/trash/">全台垃圾車清運時間查詢工具首頁</a>
    </li>
  </ul>
  {
    siblingDistricts.length > 0 && (
      <>
        <h3>{city.name}其他行政區</h3>
        <ul class="chip-list">
          {siblingDistricts.map((d) => (
            <li>
              <a href={`/trash/${city.slug}/${d.districtSlug}/`}>{d.district}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <h3>其他縣市</h3>
  <ul class="chip-list">
    {
      CITIES.filter((c) => c.slug !== city.slug).map((c) => (
        <li>
          <a href={`/trash/${c.slug}/`}>{c.name}</a>
        </li>
      ))
    }
  </ul>

  <style>
    table td:first-child,
    table td:last-child {
      white-space: nowrap;
    }
    .chip-list {
      list-style: none;
      padding: 0;
      margin: 0.5rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .chip-list li a {
      display: inline-block;
      padding: 0.3rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.9rem;
      text-decoration: none;
    }
    .muted {
      color: var(--muted);
      font-size: 0.9rem;
    }
  </style>

  <p slot="footer">
    資料來源:{city.sourceName}(<a href={city.sourceUrl} rel="noopener">{city.name}政府資料開放平台</a>),依「政府資料開放授權條款第1版」提供。
  </p>
  <p slot="footer">本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
</BaseLayout>
