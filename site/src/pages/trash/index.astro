---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import { CITIES, TOTAL_TAIWAN_COUNTY_COUNT, loadCityPoints, groupByDistrict } from '../../lib/data';
import { breadcrumbJsonLd } from '../../lib/seo';

const cityStats = CITIES.map((city) => {
  const points = loadCityPoints(city.file);
  const districts = groupByDistrict(points);
  return { city, districtCount: districts.length, pointCount: points.length };
});
const remainingCount = TOTAL_TAIWAN_COUNTY_COUNT - CITIES.length;

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '垃圾車清運時間查詢', url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title="全台垃圾車清運時間查詢｜依縣市、行政區、清運點快速查詢"
  description="輸入地名查詢全台垃圾車清運時間與地點,依縣市、行政區、清運點分頁整理,資料來源為各縣市政府開放資料平台。"
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / 垃圾車清運時間查詢</nav>
  <h1>全台垃圾車清運時間查詢</h1>
  <p>
    找不到住家附近垃圾車幾點來嗎?本站整理全台各縣市政府公開的垃圾車清運路線與時間資料,依「縣市 → 行政區 →
    清運點」分頁呈現,協助你快速確認今天倒垃圾的時間與地點。
  </p>

  <SearchBox indexUrl="/trash/search-index.json" />

  <h2>目前開放查詢的縣市</h2>
  <ul class="card-grid">
    {
      cityStats.map(({ city, districtCount, pointCount }) => (
        <li>
          <a class="card" href={`/trash/${city.slug}/`}>
            <strong>{city.name}</strong>
            <div>{districtCount} 個行政區・{pointCount.toLocaleString('zh-Hant-TW')} 個清運點</div>
          </a>
        </li>
      ))
    }
  </ul>
  <p>其餘 {remainingCount} 縣市資料陸續建置中,尚未上線,敬請期待。</p>

  <Fragment slot="footer">
    {
      cityStats.map(({ city }) => (
        <p>
          {city.name}資料來源:{city.sourceName}(<a href={city.sourceUrl} rel="noopener">資料開放平台</a>),依「政府資料開放授權條款第1版」提供。
        </p>
      ))
    }
    <p>本站為民間非官方服務,實際清運時間如有變動,請以清潔隊公告為準。</p>
  </Fragment>
</BaseLayout>
