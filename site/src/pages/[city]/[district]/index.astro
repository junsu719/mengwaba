---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadKaohsiungPoints, groupByDistrict, parsePointId, CITY_SLUG, CITY_NAME } from '../../../lib/data';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { districtNoteSentence, weekdayListText } from '../../../lib/content';

export function getStaticPaths() {
  const points = loadKaohsiungPoints();
  const districts = groupByDistrict(points);
  return districts.map((g) => ({
    params: { city: CITY_SLUG, district: g.districtSlug },
    props: { group: g },
  }));
}

const { group } = Astro.props;

const sortedByTime = [...group.points].sort((a, b) => {
  const at = a.schedule[0]?.arrive ?? '99:99';
  const bt = b.schedule[0]?.arrive ?? '99:99';
  return at.localeCompare(bt);
});

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: CITY_NAME, url: new URL(`/${CITY_SLUG}/`, Astro.site ?? Astro.url).href },
    { name: group.district, url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title={`${group.district}垃圾車時間查詢｜${CITY_NAME}${group.district}清運點總表`}
  description={`${CITY_NAME}${group.district}垃圾車清運時間總表,共 ${group.points.length} 個清運點,依到站時間排序,點選查看各點詳細時刻與地址。`}
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / <a href={`/${CITY_SLUG}/`}>{CITY_NAME}</a> / {group.district}</nav>
  <h1>{group.district}垃圾車清運時間查詢</h1>
  <p>{districtNoteSentence(group)}</p>

  <h2>清運點列表</h2>
  <ul class="plain">
    {
      group.points.map((p) => {
        const { pointSlug } = parsePointId(p.point_id);
        return (
          <li>
            <a href={`/${CITY_SLUG}/${group.districtSlug}/${pointSlug}/`}>{p.point_name}</a>
            {p.village ? ` ・${p.village}` : ''}
          </li>
        );
      })
    }
  </ul>

  <h2>時段總表(依到站時間排序)</h2>
  <table>
    <thead>
      <tr>
        <th>到站時間</th>
        <th>清運點</th>
        <th>里別</th>
        <th>收運日</th>
      </tr>
    </thead>
    <tbody>
      {
        sortedByTime.map((p) => {
          const { pointSlug } = parsePointId(p.point_id);
          const entry = p.schedule[0];
          return (
            <tr>
              <td>{entry ? `${entry.arrive}〜${entry.depart}` : '—'}</td>
              <td>
                <a href={`/${CITY_SLUG}/${group.districtSlug}/${pointSlug}/`}>{p.point_name}</a>
              </td>
              <td>{p.village ?? '—'}</td>
              <td>{entry ? weekdayListText(entry.weekday) : '—'}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</BaseLayout>
