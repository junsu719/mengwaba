---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadKaohsiungPoints, groupByDistrict, CITY_SLUG, CITY_NAME } from '../../lib/data';
import { breadcrumbJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return [{ params: { city: CITY_SLUG } }];
}

const points = loadKaohsiungPoints();
const districts = groupByDistrict(points);

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: CITY_NAME, url: Astro.url.href },
  ]),
];
---

<BaseLayout
  title={`${CITY_NAME}垃圾車清運時間查詢｜各行政區清運時刻總表`}
  description={`${CITY_NAME}全區垃圾車清運時間查詢,涵蓋 ${districts.length} 個行政區、${points.length} 個清運點,點選行政區查看該區完整時刻表。`}
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / {CITY_NAME}</nav>
  <h1>{CITY_NAME}垃圾車清運時間查詢</h1>
  <p>
    {CITY_NAME}共有 {districts.length} 個行政區、{points.length.toLocaleString('zh-Hant-TW')} 個垃圾車定點清運點資料。點選下方行政區,查看該區所有清運點與時刻總表。
  </p>

  <ul class="card-grid">
    {
      districts.map((g) => (
        <li>
          <a class="card" href={`/${CITY_SLUG}/${g.districtSlug}/`}>
            <strong>{g.district}</strong>
            <div>{g.points.length} 個清運點</div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
