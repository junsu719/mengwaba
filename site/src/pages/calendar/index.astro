---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { CALENDAR_YEARS, loadCalendarYear, computeLeavePlans, allLongWeekendEntries } from '../../lib/calendar';
import IcsDownload from '../../components/IcsDownload.astro';
import IcsSubscribe from '../../components/IcsSubscribe.astro';
import NextLongWeekend from '../../components/NextLongWeekend.astro';

const jsonLd = [
  breadcrumbJsonLd([
    { name: '首頁', url: Astro.site ? new URL('/', Astro.site).href : '/' },
    { name: '國定假日與連假查詢', url: Astro.url.href },
  ]),
];

const years = CALENDAR_YEARS.map((year) => {
  const data = loadCalendarYear(year);
  return {
    year,
    holidayDays: data.holiday_days,
    longWeekendCount: data.long_weekends.length,
    leavePlanCount: computeLeavePlans(data).length,
  };
});
const nextLongWeekendEntries = allLongWeekendEntries();
---

<BaseLayout
  title="國定假日與連假查詢｜行事曆下載｜悶蛙吧"
  description="查詢中華民國政府行政機關辦公日曆表,各年度國定假日、補假日、3 天以上連假的起訖日與天數,並提供 .ics 行事曆下載。"
  jsonLd={jsonLd}
>
  <nav><a href="/">首頁</a> / 國定假日與連假查詢</nav>
  <h1>國定假日與連假查詢</h1>
  <p>
    資料來源為行政院人事行政總處「政府行政機關辦公日曆表」(政府資料開放平臺 <code>dataset/14718</code>),逐日列出是否放假、補假日,並依實際資料算出每年 3 天以上連假的起訖日與天數——不引用新聞稿摘要數字,一律以本站解析出的清單為準。想查今日農曆、宜忌或神明生日,請見<a href="/lunar/">農民曆查詢</a>。
  </p>

  <NextLongWeekend entries={nextLongWeekendEntries} />

  {
    years.some((y) => y.leavePlanCount > 0) && (
      <Card variant="featured">
        <h2>拼假攻略:算出最省假期的排法</h2>
        <p>
          只要多請 1~3 天特休、接上國定假日,就能換到更長的連假——本站逐年把每個機會算好,列出要請哪幾天、能連休到幾天,不用自己對照日曆排列組合。
        </p>
        <div class="leave-plan-links">
          {years
            .filter((y) => y.leavePlanCount > 0)
            .map((y) => (
              <Button variant="secondary" href={`/calendar/${y.year}/leave-plan/`}>
                {y.year} 年請假攻略({y.leavePlanCount} 個機會)
              </Button>
            ))}
        </div>
      </Card>
    )
  }

  <h2>年度總覽</h2>
  <ul class="tool-grid">
    {
      years.map((y) => (
        <li>
          <Card variant="standard" href={`/calendar/${y.year}/`}>
            <strong>{y.year} 年</strong>
            <div class="tool-desc">
              全年放假 {y.holidayDays} 天・{y.longWeekendCount} 個 3 天以上連假
            </div>
          </Card>
        </li>
      ))
    }
  </ul>

  <h2>行事曆下載</h2>
  <p>內容為當年度國定假日與補假日(不含純週末空白列):</p>
  {years.map((y) => <IcsDownload year={y.year} />)}
  <IcsSubscribe />

  <p slot="footer">
    資料來源:行政院人事行政總處「政府行政機關辦公日曆表」,依「政府資料開放授權條款第1版」提供。
  </p>
  <p slot="footer">本站為民間非官方服務,實際放假規定如有變動,請以行政院人事行政總處公告為準。</p>

  <style>
    :global(.ui-card--featured) {
      margin: var(--spacing-md) 0 var(--spacing-lg);
    }
    .leave-plan-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      margin-top: var(--spacing-sm);
    }
    .tool-grid {
      list-style: none;
      padding: 0;
      margin: 0.5rem 0 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--spacing-md);
    }
    .tool-desc {
      color: var(--color-muted);
      font-size: 0.9rem;
      margin-top: var(--spacing-xs);
    }
  </style>
</BaseLayout>
